# Copie para .env e ajuste conforme necessário.
#   cp .env.example .env
#
# Os mesmos valores alimentam o docker-compose e a aplicação Spring.
# Todos têm default no código, então a aplicação sobe mesmo sem o .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=order_control
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
